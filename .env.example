# Copiar a .env en la raíz. Nunca subir este archivo con valores reales.
APP_MODE=demo
NODE_ENV=development
PORT=3001
PUBLIC_ORIGIN=http://localhost:5173
DEMO_PASSWORD=FarmaDemo2026!
# Para producción: APP_MODE=supabase, NODE_ENV=production y HTTPS.
SUPABASE_PROJECT_NAME=farma-alvar
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Solo servidor: secret o service_role; necesaria para crear usuarios desde la aplicación.
SUPABASE_SECRET_KEY=
# Connection string del pooler de Supabase, con contraseña URL-encoded.
DATABASE_URL=
# Ruta opcional al certificado CA del servidor PostgreSQL.
DATABASE_CA_FILE=deploy/certs/supabase-ca.crt
# Para Docker con HTTPS, agregar el dominio propio (sin https://).
DOMAIN=
